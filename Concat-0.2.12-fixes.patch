+        .unwrap_or(0)
+        .saturating_add(1)
+        .clamp(1, MAX_CAPTION_WORDS)
+}
+
+/// The same source clip before a split, after a split, or another piece of
+/// that same continuous edit. Speed curves are excluded because a single
+/// constant-speed transcription request cannot describe their timing.
+fn same_caption_source(
+    left: &concat_project::model::Clip,
+    right: &concat_project::model::Clip,
+) -> bool {
+    left.track_id == right.track_id
+        && left.media_id == right.media_id
+        && left.audio_stream == right.audio_stream
+        && left.speed_curve.is_none()
+        && right.speed_curve.is_none()
+        && (left.speed - right.speed).abs() <= 1e-9
+}
+
+/// Whether two pieces still touch in both timeline time and source time.
+fn caption_pieces_touch(
+    left: &concat_project::model::Clip,
+    right: &concat_project::model::Clip,
+) -> bool {
+    const EPSILON: f64 = 1e-6;
+    (left.start + left.duration - right.start).abs() <= EPSILON
+        && (left.source_start + left.duration * left.speed - right.source_start).abs() <= EPSILON
+}
+
+/// Finds the complete contiguous split chain containing `selected`, in
+/// timeline order. Unrelated uses of the same file are not pulled in.
+fn caption_source_chain<'a>(
+    clips: impl IntoIterator<Item = &'a concat_project::model::Clip>,
+    selected: &concat_project::model::Clip,
+) -> Vec<&'a concat_project::model::Clip> {
+    let mut candidates: Vec<_> = clips
+        .into_iter()
+        .filter(|clip| same_caption_source(clip, selected))
+        .collect();
+    candidates.sort_by(|left, right| left.start.total_cmp(&right.start));
+    let Some(selected_at) = candidates.iter().position(|clip| clip.id == selected.id) else {
+        return Vec::new();
+    };
+    let mut first = selected_at;
+    while first > 0 && caption_pieces_touch(candidates[first - 1], candidates[first]) {
+        first -= 1;
+    }
+    let mut last = selected_at;
+    while last + 1 < candidates.len()
+        && caption_pieces_touch(candidates[last], candidates[last + 1])
+    {
+        last += 1;
+    }
+    candidates[first..=last].to_vec()
+}
+
+/// Splits each Whisper phrase into captions whose word counts fit the
+/// chosen range whenever that is mathematically possible. Whisper supplies
+/// phrase timestamps, not word timestamps, so a phrase's time is divided
+/// among its groups in proportion to each group's character count.
+fn word_range_segments(
+    segments: Vec<Segment>,
+    min_words: usize,
+    max_words: usize,
+) -> Vec<Segment> {
+    const MAX_MERGE_GAP: f64 = 0.6;
+
+    let min_words = min_words.clamp(1, MAX_CAPTION_WORDS);
+    let max_words = max_words.max(min_words).min(MAX_CAPTION_WORDS);
+    let split: Vec<Segment> = segments
+        .into_iter()
+        .flat_map(|segment| split_segment_words(segment, min_words, max_words))
+        .collect();
+    let mut output: Vec<Segment> = Vec::with_capacity(split.len());
+    let mut index = 0;
+
+    while index < split.len() {
+        let mut current = split[index].clone();
+        let current_words = current.text.split_whitespace().count();
+
+        // Whisper may end a phrase with only one or two words. Join that
+        // phrase to a nearby one when the pause is short and the result
+        // still fits the selected maximum. Never bridge a longer pause.
+        if current_words < min_words {
+            if let Some(next) = split.get(index + 1).filter(|next| {
+                next.start - current.end <= MAX_MERGE_GAP
+                    && current_words + next.text.split_whitespace().count() <= max_words
+            }) {
+                current.end = next.end;
+                current.text = format!("{} {}", current.text.trim(), next.text.trim());
+                index += 1;
+            } else if let Some(previous) = output.last_mut().filter(|previous| {
+                current.start - previous.end <= MAX_MERGE_GAP
+                    && previous.text.split_whitespace().count() + current_words <= max_words
+            }) {
+                previous.end = current.end;
+                previous.text = format!("{} {}", previous.text.trim(), current.text.trim());
+                index += 1;
+                continue;
+            }
+        }
+
+        output.push(current);
+        index += 1;
+    }
+    output
+}
+
+fn split_segment_words(segment: Segment, min_words: usize, max_words: usize) -> Vec<Segment> {
+    let words: Vec<&str> = segment.text.split_whitespace().collect();
+    if words.is_empty() || words.len() <= max_words {
+        return vec![segment];
+    }
+
+    let fewest_groups = words.len().div_ceil(max_words);
+    let most_groups = (words.len() / min_words).max(1);
+    let average = (min_words + max_words) as f64 / 2.0;
+    let target_groups = (words.len() as f64 / average).round() as usize;
+    let groups = target_groups.clamp(fewest_groups, most_groups.max(fewest_groups));
+    let base = words.len() / groups;
+    let extra = words.len() % groups;
+    let weights: Vec<usize> = words
+        .iter()
+        .map(|word| word.chars().count().max(1))
+        .collect();
+    let total_weight: usize = weights.iter().sum();
+    let duration = segment.end - segment.start;
+    let mut word_at = 0usize;
+    let mut consumed_weight = 0usize;
+    let mut output = Vec::with_capacity(groups);
+
+    for group_at in 0..groups {
+        let count = base + usize::from(group_at < extra);
+        let end_word = word_at + count;
+        let text = words[word_at..end_word].join(" ");
+        let group_weight: usize = weights[word_at..end_word].iter().sum();
+        let start = if group_at == 0 {
+            segment.start
+        } else {
+            segment.start + duration * consumed_weight as f64 / total_weight as f64
+        };
+        consumed_weight += group_weight;
+        let end = if group_at + 1 == groups {
+            segment.end
+        } else {
+            segment.start + duration * consumed_weight as f64 / total_weight as f64
+        };
+        output.push(Segment { start, end, text });
+        word_at = end_word;
+    }
+    output
+}
